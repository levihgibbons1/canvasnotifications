# ---- Dispatch for Canvas: server configuration ----
SERVER_PORT=8787
APP_URL=http://localhost:5173
SESSION_SECRET=change-me
SYNC_INTERVAL_MINUTES=5

# Canvas OAuth2 (optional). Requires a Developer Key created by a Canvas admin.
# Redirect URI to register on the key: http://localhost:8787/auth/canvas/callback
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=

# Email delivery (optional). Without SMTP, emails land in the in-app Outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dispatch <dispatch@example.com>"

# SMS delivery via Twilio (optional). Without it, texts land in the in-app Outbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
