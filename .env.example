# ---- Dispatch for Canvas: server configuration ----
SERVER_PORT=8787
APP_URL=http://localhost:5173
SESSION_SECRET=change-me
SYNC_INTERVAL_MINUTES=5

# Persistence. Without this, Dispatch uses a local SQLite file (data/dispatch.sqlite) —
# zero setup, but ephemeral on hosts without a persistent disk (see README > Deploying).
# Set this to a Postgres connection string (e.g. from a free Supabase project:
# Project Settings -> Database -> Connection string -> URI) for state that survives restarts.
DATABASE_URL=

# Canvas OAuth2 (optional). Requires a Developer Key created by a Canvas admin.
# Redirect URI to register on the key: http://localhost:8787/auth/canvas/callback
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=

# Email delivery (optional). Without either of these, emails land in the in-app Outbox.
#
# SendGrid (HTTP API — use this on Render's free tier and similar hosts that block
# outbound SMTP ports 25/465/587). Free plan: verify one sender address (no domain
# needed), then generate an API key. Takes priority over SMTP below if both are set.
SENDGRID_API_KEY=
#
# SMTP (works locally, on paid Render, or any host that allows outbound SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dispatch <dispatch@example.com>"

# SMS delivery via Twilio (optional). Without it, texts land in the in-app Outbox.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
